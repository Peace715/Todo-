<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-shell">
  <% const completedTasks = tasks.filter(task => task.status === 'completed').length; %>
  <% const pendingTasks = tasks.length - completedTasks; %>
  <% const reminderTasks = tasks.filter(task => task.status === 'pending' && task.dueAt); %>

  <main class="dashboard-shell">
    <div class="dashboard-topbar">
      <div class="brand-chip">
        <div>
          <strong>Task Manager</strong>
          <span>Personal focus dashboard</span>
        </div>
      </div>

      <div class="topbar-actions">
        <span class="welcome-copy">Signed in as <strong><%= user.username %></strong></span>
        <a href="/logout" class="secondary-btn">Logout</a>
      </div>
    </div>

    <section class="dashboard-grid">
      <div class="dashboard-hero">
        <div class="dashboard-hero-inner">
          <div class="eyebrow">Today&apos;s workflow</div>
          <h1 class="dashboard-title">Make progress feel visible.</h1>
          <p class="dashboard-copy">
            Capture what needs attention, finish what you can, and let the list reflect
            the work you&apos;re actually moving through.
          </p>

          <div class="stats-row">
            <div class="stat-card">
              <span class="stat-value"><%= tasks.length %></span>
              <span class="stat-label">Total tasks</span>
            </div>
            <div class="stat-card">
              <span class="stat-value"><%= pendingTasks %></span>
              <span class="stat-label">Still in motion</span>
            </div>
            <div class="stat-card">
              <span class="stat-value"><%= completedTasks %></span>
              <span class="stat-label">Wrapped up</span>
            </div>
          </div>
        </div>
      </div>

      <aside class="dashboard-panel">
        <h2 class="panel-title">Add a new task</h2>
        <p class="panel-copy">
          Keep it short and concrete so the next action is easy to pick up later.
        </p>
        <p class="muted-copy reminder-note">
          Keep this page open and tap anywhere once so reminder sound can play when a task is due.
        </p>

        <% if (typeof error !== 'undefined') { %>
          <p class="error"><%= error %></p>
        <% } %>

        <form method="POST" action="/tasks/add" class="task-form">
          <input name="title" class="text-input task-title-input" placeholder="Enter a new task..." required />
          <input
            id="dueAt"
            name="dueAt"
            type="datetime-local"
            class="text-input time-input"
          />
          <button type="submit" class="primary-btn">Add Task</button>
        </form>
      </aside>
    </section>

    <section class="dashboard-panel list-panel">
      <div class="panel-header">
        <div>
          <h2 class="panel-title">Your task list</h2>
          <p class="muted-copy">Complete what&apos;s done, remove what no longer belongs.</p>
        </div>
        <span class="task-count"><%= tasks.length %></span>
      </div>

      <div class="tasks-list">
        <% if (tasks.length === 0) { %>
          <div class="empty-state">
            <p>No tasks yet. Add one above and give the day a clear starting point.</p>
          </div>
        <% } %>

        <% tasks.forEach(task => { %>
          <div class="task-card <%= task.status === 'completed' ? 'completed' : '' %>">
            <div class="task-meta">
              <strong class="task-title"><%= task.title %></strong>
              <div class="task-details">
                <span class="task-status"><%= task.status %></span>
                <% if (task.dueAt) { %>
                  <% const isOverdue = task.status === 'pending' && new Date(task.dueAt) < now; %>
                  <span class="task-due <%= isOverdue ? 'overdue' : '' %>">
                    Due <%= new Date(task.dueAt).toLocaleString() %>
                  </span>
                <% } else { %>
                  <span class="task-due no-due">No reminder set</span>
                <% } %>
              </div>
            </div>

            <div class="task-actions">
              <% if (task.status === 'pending') { %>
                <form method="POST" action="/tasks/complete/<%= task._id %>">
                  <button class="icon-btn complete-btn" aria-label="Complete task">&#10004;</button>
                </form>
              <% } %>

              <form method="POST" action="/tasks/delete/<%= task._id %>">
                <button class="icon-btn delete-btn" aria-label="Delete task">&#10006;</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <div class="footer">
      <p>&copy; 2026 Task Manager App</p>
    </div>
  </main>

  <script>
    const reminderTasks = <%- JSON.stringify(
      reminderTasks.map((task) => ({
        id: String(task._id),
        title: task.title,
        dueAt: task.dueAt
      }))
    ) %>;

    const dueAtInput = document.getElementById('dueAt');

    if (dueAtInput) {
      const localNow = new Date();
      localNow.setMinutes(localNow.getMinutes() - localNow.getTimezoneOffset());
      dueAtInput.min = localNow.toISOString().slice(0, 16);
    }

    const storedReminderIds = JSON.parse(window.localStorage.getItem('remindedTaskIds') || '[]');
    const remindedTaskIds = new Set(storedReminderIds);
    let reminderAudioContext = null;
    let audioUnlocked = false;

    function persistReminderIds() {
      window.localStorage.setItem('remindedTaskIds', JSON.stringify(Array.from(remindedTaskIds)));
    }

    function unlockReminderAudio() {
      if (audioUnlocked) {
        return;
      }

      const AudioContextClass = window.AudioContext || window.webkitAudioContext;

      if (!AudioContextClass) {
        audioUnlocked = true;
        return;
      }

      try {
        if (!reminderAudioContext) {
          reminderAudioContext = new AudioContextClass();
        }

        if (reminderAudioContext.state === 'suspended') {
          reminderAudioContext.resume();
        }

        audioUnlocked = true;
      } catch (error) {
        console.error('Unable to unlock reminder audio:', error);
      }
    }

    ['click', 'touchstart', 'keydown'].forEach((eventName) => {
      window.addEventListener(eventName, unlockReminderAudio, { once: true });
    });

    function playReminderTone() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;

      if (!AudioContextClass) {
        return;
      }

      try {
        if (!reminderAudioContext) {
          reminderAudioContext = new AudioContextClass();
        }

        const startAt = reminderAudioContext.currentTime;

        [0, 0.32, 0.64].forEach((offset) => {
          const oscillator = reminderAudioContext.createOscillator();
          const gainNode = reminderAudioContext.createGain();

          oscillator.type = 'square';
          oscillator.frequency.setValueAtTime(880, startAt + offset);
          gainNode.gain.setValueAtTime(0.0001, startAt + offset);
          gainNode.gain.exponentialRampToValueAtTime(0.18, startAt + offset + 0.02);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, startAt + offset + 0.22);

          oscillator.connect(gainNode);
          gainNode.connect(reminderAudioContext.destination);
          oscillator.start(startAt + offset);
          oscillator.stop(startAt + offset + 0.24);
        });
      } catch (error) {
        console.error('Unable to play reminder sound:', error);
      }
    }

    function sendTaskReminder(task) {
      if (remindedTaskIds.has(task.id)) {
        return;
      }

      remindedTaskIds.add(task.id);
      persistReminderIds();

      if ('Notification' in window && Notification.permission === 'granted') {
        new Notification('Task reminder', {
          body: '"' + task.title + '" is due now.'
        });
      }

      if (audioUnlocked) {
        playReminderTone();
      }

      if ('vibrate' in navigator) {
        navigator.vibrate([250, 120, 250, 120, 250]);
      }

      window.alert('Reminder: "' + task.title + '" is due now.');
    }

    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission().catch(() => {});
    }

    function checkTaskReminders() {
      const now = Date.now();

      reminderTasks.forEach((task) => {
        const dueTime = new Date(task.dueAt).getTime();

        if (!Number.isNaN(dueTime) && dueTime <= now) {
          sendTaskReminder(task);
        }
      });
    }

    checkTaskReminders();
    window.setInterval(checkTaskReminders, 30000);
  </script>
</body>
</html>
